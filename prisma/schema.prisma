generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Show {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  city             String
  venue            String
  ticketLink       String?
  doorsTime        String?
  coverImage       String?
  coverWidth       Int?
  coverHeight      Int?
  coverBlurDataURL String?
  isFeatured       Boolean  @default(false)
  isHidden         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([isFeatured])
  @@index([isHidden])
}

model Album {
  id               String   @id @default(cuid())
  title            String
  year             Int
  subtitle         String?
  coverImage       String?
  coverWidth       Int?
  coverHeight      Int?
  coverBlurDataURL String?
  spotify          String?
  appleMusic       String?
  isHidden         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([year])
  @@index([isHidden])
}

model PlayerVote {
  id         String   @id @default(cuid())
  playerId   String
  voterToken String   @unique
  createdAt  DateTime @default(now())

  @@index([playerId])
}

model Subscriber {
  id              String    @id @default(cuid())
  email           String    @unique
  source          String    @default("game")
  marketingConsent Boolean  @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  runs GameRun[]

  @@index([source])
  @@index([createdAt])
}

model GameRun {
  id             String    @id @default(cuid())
  subscriberId   String?
  subscriber     Subscriber? @relation(fields: [subscriberId], references: [id])
  seed           Int
  contentVersion Int
  state          Json
  memberId       String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([memberId])
  @@index([completedAt])
  @@index([subscriberId])
}
